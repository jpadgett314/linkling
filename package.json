{
  "name": "linkling-server",
  "version": "0.3.1",
  "private": true,
  "description": "JSON-based bookmark server",
  "author": {
    "name": "Jacob Padgett",
    "url": "https://github.com/jpadgett314/"
  },
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "clean": "rm -rf dist",
    "build:bundle": "node build.esbuild.mjs",
    "build:sea": "node --build-sea config.sea.json",
    "build": "npm run clean && npm run build:bundle && npm run build:sea",
    "package": "./build.flatpak.sh"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "multer": "^1.4.5-lts.2",
    "write-file-atomic": "^7.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
